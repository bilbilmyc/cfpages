{
  "name": "cfpages-docker-hub-mirror",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "dev": "npm run build && wrangler pages dev dist --port 8788",
    "deploy": "npm run build && wrangler pages deploy dist --project-name cfpages --branch main",
    "test": "vitest run",
    "check": "npm run build && npm test"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.33.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
