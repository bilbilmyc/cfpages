{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cfpages-local",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-09-01",
  "vars": {
    "ADMIN_TOKEN": "test-only-secret-with-at-least-32-characters"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "cfpages-local-only",
    "database_id": "00000000-0000-0000-0000-000000000001",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{"binding": "IMAGES", "bucket_name": "cfpages-local-only"}]
}
